+    | Some other -> N.append other.name "rec")] in
+  let helpers = [(List.nth recnames 0, root_type, root_prop);
+                 (List.nth recnames 1, list_type, list_prop)] in
+  let lookup rname = match List.find_opt (fun r -> N.equal r.rname rname) ind.recursors with
+    | Some r -> r | None -> CErrors.user_err Pp.(str "missing exported recursor") in
+  let expected_ctors rname = if N.equal rname (List.nth recnames 0)
+    then List.map fst ind.ctors
+    else match secondary with Some other -> List.map fst other.ctors
+    | None -> [N.append_list N.anon ["List";"nil"]; N.append_list N.anon ["List";"cons"]] in
+  let minor_count = List.length ind.ctors + (match secondary with None -> 2
+    | Some other -> List.length other.ctors) in
+  List.iter (fun r ->
+    let expected = expected_ctors r.rname in
+    let actual = List.map (fun rule -> rule.constructor) r.rules in
+    if List.length actual <> List.length expected ||
+       not (List.for_all (fun c -> List.length (List.filter (N.equal c) actual) = 1) expected) then
+      CErrors.user_err Pp.(str "missing or duplicate exported nested recursor reduction");
+    List.iter (fun rule ->
+      let uconv = start_uconv [] 0 in
+      let _, ctor = instantiate rule.constructor
+        (if List.exists (N.equal rule.constructor)
+          [N.append_list N.anon ["List";"nil"];N.append_list N.anon ["List";"cons"]]
+         then [U.Prop] else []) uconv in
+      let ((mind,packet),index),_ = Constr.destConstruct ctor in
+      let fields = (Global.lookup_mind mind).mind_packets.(packet).mind_consnrealargs.(index-1) in
+      if fields <> rule.fields then CErrors.user_err Pp.(str "exported nested recursor constructor arity differs")) r.rules
+  ) ind.recursors;
+  let helper_ref s = Nametab.locate (Libnames.qualid_of_string s) in
+  let check_signature (rname, type_name, prop_name) i =
+    Feedback.msg_notice Pp.(str "Checking signature " ++ N.pp rname ++ str " instance " ++ int i);
+    let r = lookup rname in
+    if List.length r.runivs <> 1 || r.nparams <> 0 || r.nmotives <> 2
+       || r.nminors <> minor_count then
+      CErrors.user_err Pp.(str "unsupported exported recursor arity");
+    let uconv = start_uconv r.runivs i in
+    let uconv, ty = to_constr empty_env r.rty uconv in
+    let levels = List.filter_map (fun u -> match N.Map.get u uconv.map with
+      | LSProp -> None | Level l -> Some l) r.runivs in
+    let href = helper_ref (if i = 0 then type_name else prop_name) in
+    let arity = UVars.AbstractContext.size (Environ.universes_of_global (Global.env ()) href) in
+    if arity <> (0,List.length levels) then
+      CErrors.user_err Pp.(str "helper universe arity differs from the exported recursor");
+    let helper = Constr.mkRef (href,
+        Instance.of_array ([||], Array.of_list levels)) in
+    let univs, algs = univ_entry uconv r.runivs in
+    let id = name_for (N.append rname "checked") i in
+    let ref = quickdef ~name:id ~types:(Some ty) ~univs helper in
+    add_declared rname i { ref; algs }
+  in
+  List.iter (fun h -> List.iter (check_signature h) [0;1]) helpers;
+  let check_rule r i rule =
+    Feedback.msg_notice Pp.(str "Checking reduction " ++ N.pp r.rname ++ str " constructor " ++ N.pp rule.constructor ++ str " instance " ++ int i);
+    let uconv = start_uconv r.runivs i in
+    let uconv, rhs = to_constr empty_env rule.rhs uconv in
+    let ctx, rhs = Term.decompose_lambda_decls rhs in
+    let base = r.nparams + r.nmotives + r.nminors in
+    if List.length ctx <> base + rule.fields then
+      CErrors.user_err Pp.(str "exported recursor rule lambda arity differs");
+    let nargs = List.length ctx in
+    let fields = Array.init rule.fields (fun k -> Constr.mkRel (rule.fields-k)) in
+    let list_ctor = N.equal rule.constructor (N.append_list N.anon ["List";"nil"])
+                 || N.equal rule.constructor (N.append_list N.anon ["List";"cons"]) in
+    let uconv, ctor = instantiate rule.constructor (if list_ctor then [U.Prop] else []) uconv in
+    let uconv, indref = instantiate n [] uconv in
+    let ctorargs = if list_ctor then Array.append [|indref|] fields else fields in
+    let ctor = if Array.length ctorargs = 0 then ctor else Constr.mkApp (ctor,ctorargs) in
+    let uconv, recursor = instantiate r.rname [U.UNamed (List.hd r.runivs)] uconv in
+    let allargs = Array.append (Array.init base (fun k -> Constr.mkRel(nargs-k))) [|ctor|] in
+    let lhs = Constr.mkApp (recursor,allargs) in
+    let env = Environ.push_rel_context ctx (Environ.set_universes uconv.graph (Global.env ())) in
+    let sigma = Evd.from_env env in
+    let ty = EConstr.to_constr sigma (Retyping.get_type_of env sigma (EConstr.of_constr lhs)) in
+    let eqref, reflref, levels = if i = 0 then
+      let level = match N.Map.get (List.hd r.runivs) uconv.map with Level u -> u | _ -> assert false in
+      (Rocqlib.lib_ref "lean.Eq", Nametab.locate (Libnames.qualid_of_string "Lean.eq_refl"), [|level|])
+    else (Rocqlib.lib_ref "lean.Eq_inst1", Nametab.locate (Libnames.qualid_of_string "Lean.eq_refl_inst1"), [||]) in
+    let ui = Instance.of_array ([||],levels) in
+    let expected = Constr.mkApp(Constr.mkRef(eqref,ui),[|ty;lhs;rhs|]) in
+    let proof = Constr.mkApp(Constr.mkRef(reflref,ui),[|ty;lhs|]) in
+    let expected = Term.it_mkProd_or_LetIn expected ctx in
+    let proof = Term.it_mkLambda_or_LetIn proof ctx in
+    let univs, _ = univ_entry uconv r.runivs in
+    let id = name_for (N.append (N.append r.rname "reduction") (N.to_coq_string rule.constructor)) i in
+    ignore (quickdef ~name:id ~types:(Some expected) ~univs proof)
+  in
+  List.iter (fun r -> List.iter (fun i -> List.iter (check_rule r i) r.rules) [0;1]) ind.recursors;
+  List.iter (fun r -> checked_special := N.Set.add r.rname !checked_special) ind.recursors;
+  Lib.add_leaf (lean_obj (!pstate, !sets, !declared, !entries, !squash_info, !height_cache, !checked_special));
+  Feedback.msg_notice Pp.(str "Kernel checked recursor signatures and all exported reductions for " ++ N.pp n)
+
+
+let assert_complete () =
+  let flags = Global.typing_flags () in
+  if not (flags.check_guarded && flags.check_positive && flags.check_universes
+          && flags.check_eliminations) || error_mode (Failure "completion") <> Fail
+          || skip_missing_quot () then
+    CErrors.user_err Pp.(str "import completion requires strict kernel and error checks");
+  N.Map.iter (fun _ -> function
+    | Ind ind when ind.nested > 0 || ind.group <> [] ->
+      if ind.recursors = [] then CErrors.user_err Pp.(str "missing exported recursor metadata");
+      List.iter (fun r -> if not (N.Set.mem r.rname !checked_special) then
+        CErrors.user_err Pp.(str "unchecked deferred recursor " ++ N.pp r.rname)) ind.recursors
+    | _ -> ()) !entries;
+  Feedback.msg_notice Pp.(str "All deferred recursor signatures and reduction rules are kernel checked")
+
