  "status": "Supporting VM implementation/proof connection checked; integrated M5.2 delivery acceptance remains root-owned.",
  "specs": [
    "\u00a7FS-host-boundary.transport",
    "\u00a7FS-host-boundary.ownership",
    "\u00a7FS-host-boundary.caller",
    "\u00a7AR-host-boundary.interfaces",
