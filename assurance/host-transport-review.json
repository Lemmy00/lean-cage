  "status": "Component implemented and focused checks passed; live host-engine composition and M5.2 integrated acceptance remain active.",
  "specs": [
    "\u00a7FS-host-boundary.transport",
    "\u00a7AR-host-boundary.interfaces",
    "\u00a7AR-host-boundary.acceptance"
  ],
  "claim": "The maintained total decoder bounds every finite hostile input prefix. Successful finish uniquely reconstructs exact caller-bound LCVM1 framing, terminal status and actual EOF, with unique records, bounded raw result bytes and sticky errors preserving known REPORT.",
  "intendedConsumers": [
    "Live host engine exact primitive read loop",
    "Artifacts validation of raw reports, manifests and blob content hashes"
  ],
  "decision": {
    "oneExecutable": "Proofs unfold the same Transport.State.init/byte/step/run/finish definitions used by the host engine.",
    "blobIndex": "Balanced TreeSet of exact 64-byte digest encodings; the byte ABI inverse proves injectivity and each key is below 256^64.",
    "hashBoundary": "Transport validates canonical hexadecimal digest encoding and uniqueness. Actual content SHA matching is consumed separately by Artifacts before publication.",
    "evaluation": "Useful/failure witnesses use proof-producing cbv and kernel-checked equalities, without native_decide."
  },
  "review": {
    "topPremises": "accepted_stream and related results require successful actual State.init and finish of the same State.run events; no well-formed/safe input or framing conclusion is assumed.",
    "hostileCoverage": "Event.data accepts arbitrary bytes; oversized chunks fail before toList. Unknown/reserved/oversized/duplicate/truncated/trailing/digest/aggregate/terminal and EOF-loss cases remain in the executable relation.",
    "provenance": "accepted_stream accounts for every data byte; accepted_has_eof derives an EOF input event; arbitrary_fragmentation equates all bounded chunkings of the same byte sequence.",
    "memory": "Exact retained frame cost and blob-content sums, bounded frame/index node counts, index keys below 2^512, active payload/header sizes, final digest/content-copy sum and static error messages are proved. Input normalization allocates a list only after the 65536-byte check.",
    "runtimeBoundary": "These are bounds on actual Lean values and requested copies, not an invented byte-exact Lean heap layout or constant-memory API. The actual primitive read buffer and its EOF origin must be supplied by the live engine; Linux/runtime/compiler contracts remain explicit.",
    "correctnessKind": "Finite-prefix partial correctness and inhabited useful/error executions. This record does not claim termination, observation truth, filesystem publication authority or a completed M5.2 delivery."
  },
