  "prior_reviews": {
    "assurance/host-raw-handoff-review.json": "f2ee11fecf91c377d4c8ba047204b9e0071a4e86ab13171d3f5a0d6a80c04ab3"
  },
  "review": {
    "backend": "actual_backend_source extracts an earlier actual owned birth and exact source spawn/args from the same initially empty process registry and actor journal. Committed spawn errors/loss remain possible; process lifetime tokens are distinct from reusable PID values. Per-child syscall recording/effect production remains to be integrated.",
    "conditional_caller_boundary": "actual_snapshot_guarded_read consumes the actual freeze prefix plus its literal caller-context equality; final application source cuts must supply those for the same caller workspace/stdin/budgets. It accepts no independently chosen guarded-fd receipt. selected_guarded_read_excludes still requires the key marker at that exact earlier guard snapshot; the global key-marker/authority producer is not hidden or claimed completed.",
    "primitive_crypto": "CryptographicContract contains only individual actual SHA/HMAC/equality correctness laws. It asserts neither digest/tag injectivity nor deterministic universal unforgeability.",
    "publisher": "Every returned/error/lost publication attribute setter derives the actual authenticated entrypoint, same parent/fresh stage, exact policy hash and encoded envelope, loaded-key MAC call and successful content fill. Its genuine MAC syscall is at an earlier global position in that same actor journal.",
    "remaining": "Native handoff instance; global source-derived private-family/backing/retirement fold; separate controller/QEMU child effects; key-marker persistence and source-scoped cryptographic forgery reduction; joint useful model and integrated M5.2 acceptance.",
    "snapshot": "Every selected returned/lost read in actual Snapshot.freeze has the source final-child/file guard. The same recorded source operations preserve that exact raw/OFD handle through retained-CWD lookup, ancestry audit, recursive traversal and copying. The successful getAttribute61 tick is strictly earlier than the selected read; numeric descriptor equality alone is never treated as object identity.",
    "verification": "recorded_verification interprets the actual internal HMAC and fixed-time equality call. It does not declare that internal computation a published oracle query and does not infer publisher origin from an arbitrary initial xattr."
  },
